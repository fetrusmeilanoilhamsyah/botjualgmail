# ─── BOT ──────────────────────────────────────────────────────────────────────
BOT_TOKEN=ISI_TOKEN_BOT_TELEGRAM_DISINI
ADMIN_IDS=1341856464
ADMIN_CONTACT=@haifee2nd
BOT_USERNAME=botjualgmail_bot

# ─── PAKASIR PAYMENT GATEWAY ──────────────────────────────────────────────────
# API key BERBEDA dari botcv, tapi akun Pakasir sama
PAKASIR_ENABLED=true
PAKASIR_SLUG=botjualgmail-produksi
PAKASIR_API_KEY=ISI_API_KEY_PAKASIR_DISINI
PAKASIR_SANDBOX=false
PAKASIR_WEBHOOK_SECRET=ISI_WEBHOOK_SECRET_DISINI

# ─── SERVER PORTS (BERBEDA dari botcv agar tidak bentrok!) ─────────────────────
# botcv  pakai: WEBHOOK=8081, HEALTH=8080
# botjual pakai: WEBHOOK=8083, HEALTH=8084
WEBHOOK_PORT=8083
HEALTH_PORT=8084

# ─── REFERRAL ─────────────────────────────────────────────────────────────────
# Saldo rupiah yang didapat per referral berhasil
REFERRAL_BONUS=500
# Batas waktu deteksi bot (detik): jika X user daftar dalam Y detik via link yg sama → banned
REFERRAL_SPAM_WINDOW=10
REFERRAL_SPAM_THRESHOLD=5

# ─── GARANSI ──────────────────────────────────────────────────────────────────
# Lama garansi dalam jam setelah pembelian
GARANSI_JAM=24

# ─── TOPUP LIMITS ─────────────────────────────────────────────────────────────
TOPUP_MIN=10000
TOPUP_MAX=1000000

# ─── NOTIFIKASI ADMIN ─────────────────────────────────────────────────────────
# ID grup/channel untuk notifikasi transaksi ke admin
ADMIN_NOTIF_CHAT=1341856464

# ─── LOCAL TELEGRAM BOT API (TELELOKAL) ────────────────────────────────────────
# Share telelokal yang sama dengan botcv (port 8082) — tidak perlu install ulang!
# Set true jika deploy di VPS dan telegram-bot-api lokal sudah jalan
USE_LOCAL_BOT_API=true
LOCAL_BOT_API_PORT=8082
